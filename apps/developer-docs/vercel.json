    },
    {
      "source": "/api-reference/cycle-issue/add-cycle-issue",
      "destination": "/api-reference/cycle/add-cycle-work-items"
    },
    {
      "source": "/api-reference/cycle-issue/list-cycle-issues",
      "destination": "/api-reference/cycle/list-cycle-work-items"
    },
    {
      "source": "/api-reference/cycle-issue/delete-cycle-issue",
